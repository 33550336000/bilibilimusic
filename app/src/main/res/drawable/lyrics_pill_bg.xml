<?xml version="1.0" encoding="utf-8"?>
<!--
  「查看歌词」按钮：半透明胶囊 + 细描边。

  注意：这里**没有模糊**。Android 没有 backdrop-filter 那种"模糊身后内容"
  的能力，所以本按钮靠三件事做出"玻璃感"：
    1. 半透明白底（20%），透出身后那层极暗渐变，形成比背景略亮的色块；
    2. 1dp 白色细描边，勾出边界——这是"玻璃边缘"的关键，
       没有它在浅色背景上按钮会整块糊掉、看不出形状；
    3. 圆角半径 26dp > 高度 46dp 的一半，四角被裁成半圆，即胶囊。
  之所以像毛玻璃，是因为按钮背后的背景是一层**平滑渐变**（无高频细节）：
  半透明叠上去显得均匀柔和，不会暴露"其实没模糊"。
  若它压在清晰照片上，立刻就能看出只是块半透明面板。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#33FFFFFF" />
    <corners android:radius="26dp" />
    <stroke
        android:width="1dp"
        android:color="#59FFFFFF" />
</shape>
