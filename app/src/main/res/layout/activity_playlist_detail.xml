<?xml version="1.0" encoding="utf-8"?>
<!-- 外层 FrameLayout 只作「背景宿主」：视频/图片背景必须与内容**层叠**，
     由它承载背景层；内层 detail_root 仍是页面内容，id 与语义不变。
     背景宿主必须是允许子 View 重叠的容器——FrameLayout 正是如此。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detail_bg_host"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

<LinearLayout
    android:id="@+id/detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:keepScreenOn="true">

    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_menu_revert"
        android:layout_margin="8dp"
        android:contentDescription="@string/back" />

    <ImageButton
        android:id="@+id/btn_add_playlist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_plus_custom"
        android:background="@android:color/transparent"
        android:layout_gravity="end"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/add_to_playlist" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sub_playlist"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:padding="12dp"
        android:visibility="gone"
        android:id="@+id/tv_sub_playlist_title"/>

    <HorizontalScrollView
        android:id="@+id/hsv_sub_playlists"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/ll_sub_playlists"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <ListView
        android:id="@+id/lv_sub_playlist"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#00000000"
        android:visibility="gone"/>

    <EditText
        android:id="@+id/et_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/search_in_playlist"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:background="#00000000"
        android:padding="12dp"
        android:inputType="text"
        android:importantForAutofill="no" />

    <ListView
        android:id="@+id/lv_music_detail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#00000000" />
</LinearLayout>

</FrameLayout>
