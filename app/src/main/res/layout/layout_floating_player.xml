<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮播放控制栏：挂在 MainPagerActivity 的根布局上（与翻页控件平级），
  所以不跟着页面左右滑动，任何页面都看得到。外边距让它离开屏幕边缘；
  底部导航栏打开时 BaseActivity 会给根布局加 paddingBottom，它会自动被抬上去。
-->
<com.tilixibiesi.ui.widget.LiquidGlassLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_player_control"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:visibility="gone"
    android:layout_marginHorizontal="10dp"
    android:layout_marginBottom="10dp"
    android:elevation="12dp">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_control_cover"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/np_cover_bg"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_cover_placeholder"
            android:contentDescription="@string/now_playing_cover" />

        <TextView
            android:id="@+id/tv_current_music"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:textSize="17sp"
            android:textColor="#FF000000"
            android:ellipsize="end"
            android:maxLines="2"
            android:gravity="top" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/seekbar_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_detail"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/detail"
            android:textSize="16sp"
            android:textColor="#FF000000"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:textAllCaps="false"
            android:paddingHorizontal="10dp" />

        <ImageButton
            android:id="@+id/btn_timer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_timer_white"
            android:tint="#FF000000"
            android:scaleType="fitCenter"
            android:padding="6dp"
            android:contentDescription="@string/timer" />

        <ImageButton
            android:id="@+id/btn_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#FF000000"
            android:contentDescription="@string/previous" />

        <ImageButton
            android:id="@+id/btn_play_pause"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_play"
            android:tint="#FF000000"
            android:contentDescription="@string/play_pause" />

        <ImageButton
            android:id="@+id/btn_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_next"
            android:tint="#FF000000"
            android:contentDescription="@string/next" />

        <ImageButton
            android:id="@+id/btn_play_mode"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#FF000000"
            android:contentDescription="@string/play_mode" />
    </LinearLayout>
</LinearLayout>
</com.tilixibiesi.ui.widget.LiquidGlassLayout>
