<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@null"
    android:paddingHorizontal="16dp">
    <TextView
        android:id="@+id/tv_index"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:textColor="#888888"
        android:textSize="14sp" />
    <LinearLayout
        android:id="@+id/layout_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_toEndOf="@id/tv_index"
        android:layout_toStartOf="@id/layout_right"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tv_music_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/tv_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:visibility="gone"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/layout_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/btn_move"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="0dp"
            android:text="@string/arrow_right"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:contentDescription="@string/move" />
        <ImageButton
            android:id="@+id/btn_add_to_playlist"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="0dp"
            android:src="@drawable/ic_plus_custom"
            android:tint="#FFFFFF"
            android:contentDescription="@string/join_playlist" />
        <TextView
            android:id="@+id/btn_delete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="0dp"
            android:text="@string/plus_sign"
            android:textColor="#FF0000"
            android:textSize="24sp"
            android:rotation="45"
            android:visibility="gone"
            android:contentDescription="@string/delete" />
    </LinearLayout>
</RelativeLayout>