<?xml version="1.0" encoding="utf-8"?>
<!-- 外层 FrameLayout 只作「背景宿主」：视频/图片背景必须与内容**层叠**，
     由它承载背景层；内层 playlist_root 仍是页面内容，id 与语义不变。
     背景宿主必须是允许子 View 重叠的容器——FrameLayout 正是如此。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playlist_bg_host"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

<LinearLayout
    android:id="@+id/playlist_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:keepScreenOn="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/tv_playlist_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/playlist"
            android:textSize="18sp"
            android:textColor="#1A1B21" />

        <ImageButton
            android:id="@+id/btn_add_playlist"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_plus_custom"
            android:contentDescription="@string/add_playlist" />
    </LinearLayout>
    <ListView
        android:id="@+id/lv_playlists"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>

</FrameLayout>
