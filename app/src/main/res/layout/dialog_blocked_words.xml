<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_blocked_words_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/block_songs_title"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_block_word"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/edittext_bg"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:hint="@string/block_word_hint"
            android:padding="12dp"
            android:inputType="text"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/btn_add_word"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add"
            android:textColor="#000000"
            android:background="@drawable/button_background"
            android:textAllCaps="false"
            android:paddingHorizontal="16dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_blocked_words_current"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/current_blocked_words"
        android:textColor="#FFFFFF"
        android:textSize="14sp"/>

    <ListView
        android:id="@+id/lv_blocked_words"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="#33FFFFFF"
        android:divider="#444444"
        android:dividerHeight="1dp"/>
</LinearLayout>