<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_bg_host"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF121212"
    tools:ignore="MergeRootFrame"
    android:keepScreenOn="true">

    <LinearLayout
        android:id="@+id/activity_main_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all_songs"
                android:textSize="20sp"
                android:textColor="#FFFFFFFF"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true" />

        </RelativeLayout>

        <ListView
            android:id="@+id/lv_music"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@null"
            android:paddingBottom="0dp"
            android:divider="#22FFFFFF"
            android:dividerHeight="1dp" 
            android:clipToPadding="false"
            android:scrollbars="none"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_gravity="top"
        android:paddingTop="12dp"
        android:paddingHorizontal="16dp"
        android:background="@android:color/transparent"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no">

        <TextView
            android:id="@+id/tv_total_today_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="#FFCCCCCC"
            android:ellipsize="end"
            android:maxLines="1"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_today_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="#FFCCCCCC"
            android:ellipsize="end"
            android:maxLines="1"
            android:visibility="gone" />

    </LinearLayout>

    <com.tilixibiesi.ui.AccessibleTextView
        android:id="@+id/btn_search_float"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/search"
        android:textSize="20sp"
        android:textColor="#FFFFFFFF"
        android:background="?android:attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp" />

</FrameLayout>
