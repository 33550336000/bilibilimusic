<?xml version="1.0" encoding="utf-8"?>


<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/np_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/now_playing_bg"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/np_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/np_topbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <ImageButton
                android:id="@+id/iv_np_collapse"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_chevron_down"
                android:contentDescription="@string/now_playing_collapse" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/np_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="24dp">

            <com.tilixibiesi.ui.widget.SquareLayout
                android:id="@+id/np_cover_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/np_cover_bg">

                <ImageView
                    android:id="@+id/iv_np_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_cover_placeholder"
                    android:contentDescription="@string/now_playing_cover" />
            </com.tilixibiesi.ui.widget.SquareLayout>

            <LinearLayout
                android:id="@+id/np_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_np_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFFFF"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_np_artist"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="15sp"
                        android:textColor="#FFB0B0B0"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <ImageButton
                        android:id="@+id/btn_np_share"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_share"
                        android:contentDescription="@string/now_playing_share" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_np_album"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="13sp"
                    android:textColor="#FF7E7E7E"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <SeekBar
                    android:id="@+id/sb_np_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/np_seekbar_track"
                    android:thumb="@drawable/np_seekbar_thumb"
                    android:splitTrack="false" />

                <LinearLayout
                    android:id="@+id/np_times"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_np_cur"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textSize="13sp"
                        android:textColor="#FFB0B0B0" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tv_np_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textSize="13sp"
                        android:textColor="#FFB0B0B0" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/np_controls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/btn_np_prev"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_media_previous"
                        android:contentDescription="@string/previous" />

                    <ImageButton
                        android:id="@+id/btn_np_play"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:layout_marginHorizontal="18dp"
                        android:background="@drawable/play_pause_circle"
                        android:padding="20dp"
                        android:scaleType="fitCenter"
                        android:src="@android:drawable/ic_media_play"
                        android:contentDescription="@string/play_pause" />

                    <ImageButton
                        android:id="@+id/btn_np_next"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_media_next"
                        android:contentDescription="@string/next" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/np_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="24dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_np_lyrics"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="28dp"
            android:background="@drawable/lyrics_pill_bg"
            android:drawableStart="@drawable/ic_lyrics"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:paddingHorizontal="22dp"
            android:text="@string/now_playing_view_lyrics"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/np_lyrics"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_np_blur"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#A6000000" />

        <LinearLayout
            android:id="@+id/np_lyrics_body"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="72dp"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tv_lrc_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_lrc_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textSize="15sp"
                android:textColor="#FFD0D0D0"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_lrc_album"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textSize="13sp"
                android:textColor="#FF9E9E9E"
                android:maxLines="1"
                android:ellipsize="end" />

            <ScrollView
                android:id="@+id/sv_np_lyrics"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="36dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/ll_np_lyrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="80dp" />
            </ScrollView>

            <TextView
                android:id="@+id/tv_np_no_lyrics"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/now_playing_no_lyrics"
                android:textColor="#FFB0B0B0"
                android:textSize="17sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
